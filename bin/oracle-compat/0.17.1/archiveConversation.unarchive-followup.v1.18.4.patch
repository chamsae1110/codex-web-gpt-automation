 }
+export async function unarchiveChatGptConversation(Runtime, logger, { expectedConversationUrl, }) {
+    const evaluated = await Runtime.evaluate({
+        expression: buildUnarchiveConversationExpression(expectedConversationUrl),
+        awaitPromise: true,
+        returnByValue: true,
+    });
+    const value = evaluated.result?.value;
+    if (value?.status !== "unarchived" || value?.conversationUrl !== expectedConversationUrl) {
+        const reason = value?.reason ?? value?.error ?? "unarchive-failed";
+        throw new Error(`FOLLOWUP_ARCHIVED_PARENT_UNARCHIVE_FAILED: ${reason}`);
+    }
+    logger("[browser] Restored exact archived ChatGPT conversation for follow-up.");
+    return value;
+}
+export function buildUnarchiveConversationExpressionForTest(expectedConversationUrl) {
+    return buildUnarchiveConversationExpression(expectedConversationUrl);
+}
+function buildUnarchiveConversationExpression(expectedConversationUrl) {
+    const expected = JSON.stringify(expectedConversationUrl);
+    return `(() => {
+    const expectedConversationUrl = ${expected};
+    const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
+    const normalize = (value) => String(value ?? '').replace(/\\s+/g, ' ').trim().toLowerCase();
+    const canonical = (value) => {
+      try {
+        const url = new URL(value);
+        if (url.protocol !== 'https:' || url.hostname !== 'chatgpt.com' || !/^\\/c\\/[a-z0-9-]+\\/?$/i.test(url.pathname)) return null;
+        url.search = '';
+        url.hash = '';
+        url.pathname = url.pathname.replace(/\\/$/, '');
+        return url.href;
+      } catch { return null; }
+    };
+    const expectedCanonical = canonical(expectedConversationUrl);
+    const currentCanonical = canonical(location.href);
+    const isVisible = (element) => {
+      if (!element || !(element instanceof HTMLElement)) return false;
+      const rect = element.getBoundingClientRect();
+      const style = getComputedStyle(element);
+      return rect.width > 0 && rect.height > 0 && style.visibility !== 'hidden' && style.display !== 'none';
+    };
+    const labelFor = (element) => normalize([
+      element.getAttribute?.('aria-label'), element.getAttribute?.('title'), element.textContent,
+    ].filter(Boolean).join(' '));
+    const click = (element) => {
+      const rect = element.getBoundingClientRect();
+      const init = { bubbles: true, cancelable: true, view: window,
+        clientX: rect.left + rect.width / 2, clientY: rect.top + rect.height / 2, button: 0 };
+      element.dispatchEvent(new MouseEvent('mousedown', { ...init, buttons: 1 }));
+      element.dispatchEvent(new MouseEvent('mouseup', { ...init, buttons: 0 }));
+      element.dispatchEvent(new MouseEvent('click', { ...init, buttons: 0 }));
+    };
+    const menuButton = () => Array.from(document.querySelectorAll('button,[role="button"]'))
+      .filter((element) => element instanceof HTMLElement && isVisible(element))
+      .map((element) => ({ element, label: labelFor(element), rect: element.getBoundingClientRect() }))
+      .filter(({ label, rect }) => rect.top < 180 && rect.right > window.innerWidth - 420 && (
+        label.includes('more') || label.includes('conversation options') || label.includes('open menu') ||
+        label.includes('więcej') || label.includes('opcje') || label.includes('더 보기') || label.includes('메뉴')
+      )).sort((a, b) => b.rect.right - a.rect.right)[0]?.element ?? null;
+    const menuItems = () => Array.from(document.querySelectorAll(
+      '[role="menu"] [role="menuitem"],[role="menu"] [role="option"],[role="menu"] button,[role="dialog"] button'
+    )).filter((element) => element instanceof HTMLElement && isVisible(element));
+    const isUnarchive = (label) => label.includes('unarchive') || label.includes('restore') ||
+      label.includes('przywróć') || label.includes('przywroc') || label.includes('보관 취소') ||
+      label.includes('보관 해제') || label.includes('복원');
+    const isArchive = (label) => !isUnarchive(label) && (
+      label.includes('archive') || label.includes('archiwizuj') || label.includes('보관')
+    );
+    return (async () => {
+      if (!expectedCanonical || currentCanonical !== expectedCanonical) {
+        return { status: 'failed', reason: 'exact-conversation-url-mismatch', conversationUrl: location.href };
+      }
+      const opener = menuButton();
+      if (!opener) return { status: 'failed', reason: 'conversation-menu-not-found', conversationUrl: location.href };
+      click(opener);
+      await sleep(350);
+      const candidates = menuItems().filter((element) => isUnarchive(labelFor(element)));
+      if (candidates.length !== 1) {
+        document.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true }));
+        return { status: 'failed', reason: candidates.length ? 'unarchive-menu-ambiguous' : 'unarchive-menu-not-found', conversationUrl: location.href };
+      }
+      click(candidates[0]);
+      await sleep(600);
+      const confirm = menuItems().filter((element) => isUnarchive(labelFor(element)));
+      if (confirm.length === 1) {
+        click(confirm[0]);
+        await sleep(600);
+      }
+      if (canonical(location.href) !== expectedCanonical) {
+        return { status: 'failed', reason: 'conversation-url-changed', conversationUrl: location.href };
+      }
+      const verify = menuButton();
+      if (!verify) return { status: 'failed', reason: 'conversation-menu-lost', conversationUrl: location.href };
+      click(verify);
+      await sleep(350);
+      const labels = menuItems().map((element) => labelFor(element));
+      const unarchiveStillPresent = labels.some(isUnarchive);
+      const archiveNowPresent = labels.some(isArchive);
+      document.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true }));
+      if (unarchiveStillPresent || !archiveNowPresent) {
+        return { status: 'failed', reason: 'unarchive-not-confirmed', conversationUrl: location.href };
+      }
+      return { status: 'unarchived', conversationUrl: expectedConversationUrl };
+    })().catch((error) => ({ status: 'failed', error: error instanceof Error ? error.message : String(error), conversationUrl: location.href }));
+  })()`;
+}
 export function buildArchiveConversationExpressionForTest() {
     return buildArchiveConversationExpression();
 }
